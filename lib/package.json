{
  "name": "xeerpe",
  "version": "1.0.6",
  "private": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./animations.css": "./dist/animations.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "AGENTS.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "css",
    "gradient",
    "css-gradient",
    "mesh-gradient",
    "linear-gradient",
    "radial-gradient",
    "conic-gradient",
    "background",
    "animated-background",
    "css-animation",
    "css-in-js",
    "inline-styles",
    "noise",
    "grain",
    "vignette",
    "glow",
    "pattern",
    "typescript",
    "gradient-generator",
    "background-generator",
    "gradient-text",
    "zero-dependencies",
    "react",
    "vue",
    "angular",
    "xeerpe",
    "javascript",
    "builder",
    "chainable",
    "fluent-api",
    "style-builder",
    "gradient-background",
    "background-effects",
    "text-gradient",
    "gradient-animation",
    "aurora",
    "shimmer",
    "dots",
    "grid",
    "stars",
    "rays",
    "blur",
    "backdrop-filter",
    "presets",
    "gradient-presets",
    "css-background",
    "nextjs"
  ],
  "homepage": "https://xeerpe.io",
  "description": "A chainable TypeScript builder for CSS backgrounds and styles: gradients, patterns, effects and animations. Zero dependencies, works with any framework: React, Vue, Angular or plain JavaScript.",
  "author": "Nicola Centonze",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolacentonze/xeerpe.git"
  },
  "scripts": {
    "build": "rm -rf dist && rspack build && tsc --emitDeclarationOnly --outDir dist && cp dist/index.d.ts dist/index.d.cts && cp src/css/animations.css dist/animations.css",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.4",
    "@rspack/core": "^2.2.4",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
