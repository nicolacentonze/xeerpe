{
  "name": "xeerpe-workspace",
  "private": true,
  "workspaces": [
    "lib",
    "doc"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=doc",
    "build:lib": "npm run build --workspace=lib",
    "build:doc": "npm run build --workspace=doc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:lib": "prettier --write lib",
    "format:doc": "prettier --write doc",
    "skill:generate": "npm run build:lib && node skills/xeerpe/scripts/generate-references.mjs && prettier --write .claude-plugin/plugin.json",
    "typecheck:lib": "npm run typecheck --workspace=lib",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:lib && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10"
  }
}
